{
    # Megmondja a Caddynek, hogy bízzon meg a Cloud Run / Google Frontend által küldött proxy fejlécekben
    servers {
        trusted_proxies static private_ranges
    }
}

:8080 {
    root * /usr/share/caddy

    # A könyvtárakat végző perjellel kanonizáljuk. Így a böngésző a relatív
    # hivatkozásokat (például egy _index.md kártyáját) nem a gyökérből oldja fel.
    @directoryWithoutSlash {
        not path */
        file {path}/index.html
    }
    redir @directoryWithoutSlash {path}/ 308

    file_server
    try_files {path} {path}/index.html {path}/ =404
}
